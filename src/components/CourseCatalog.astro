---
/**
 * CourseCatalog — the course grid on the home page.
 *
 * A two-column grid rather than a full-width vertical list: a list of wide rows
 * reads as "endless" once there are more than about four, and a grid stays
 * scannable up to roughly eight. Past that, the header nav and the per-course
 * sidebar are the real navigation and this becomes a shortcut, not the index.
 *
 * Lesson counts come from the collection, so the grid cannot drift out of date.
 */
import { getCollection } from 'astro:content';
import { COURSES } from '../lib/courses';

const lessons = await getCollection('docs', ({ data }) => Boolean(data.lesson));

// Count lessons and weeks, not pages — a four-part lesson is one lesson.
const lessonKeys = new Map<string, Set<string>>();
const weekNums = new Map<string, Set<number>>();
for (const page of lessons) {
	const { course, kind, kindNumber, week } = page.data.lesson!;
	if (!lessonKeys.has(course)) lessonKeys.set(course, new Set());
	if (!weekNums.has(course)) weekNums.set(course, new Set());
	lessonKeys.get(course)!.add(`${kind}-${kindNumber}`);
	weekNums.get(course)!.add(week);
}
---

<ul class="ck-cat not-content">
	{
		COURSES.map((course) => {
			const n = lessonKeys.get(course.slug)?.size ?? 0;
			const w = weekNums.get(course.slug)?.size ?? 0;
			const open = course.status === 'open' && n > 0;
			const Tag = open ? 'a' : 'div';
			return (
				<li>
					<Tag class:list={['ck-cat-card', { 'is-open': open }]} {...(open ? { href: course.href } : {})}>
						<div class="ck-cat-head">
							<h3>{course.title}</h3>
							{open ? (
								<span class="ck-cat-badge is-open">
									{n} lesson{n === 1 ? '' : 's'}
									{w > 0 ? ` · ${w} week${w === 1 ? '' : 's'}` : ''}
								</span>
							) : (
								<span class="ck-cat-badge">Planned</span>
							)}
						</div>
						<p>{course.blurb}</p>
						{open && (
							<span class="ck-cat-go">
								Open course <span aria-hidden="true">→</span>
							</span>
						)}
					</Tag>
				</li>
			);
		})
	}
</ul>

<style>
	.ck-cat {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.85rem;
		grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
		text-align: start;
	}

	.ck-cat li {
		margin: 0;
		display: flex;
	}

	.ck-cat-card {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		width: 100%;
		padding: 1.25rem 1.35rem;
		border: 1px solid var(--color-border);
		border-radius: var(--ck-r-lg);
		background: var(--color-canvas);
		text-decoration: none;
		transition: border-color 150ms ease, box-shadow 150ms ease, transform 150ms ease;
	}

	.ck-cat-card.is-open:hover {
		border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
		box-shadow: var(--ck-shadow);
		transform: translateY(-1px);
	}

	.ck-cat-card:not(.is-open) {
		background: var(--color-canvas-subtle);
		border-style: dashed;
	}

	.ck-cat-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.ck-cat-head h3 {
		margin: 0;
		border: 0;
		padding: 0;
		font-size: 1.0625rem;
		font-weight: 650;
		letter-spacing: -0.015em;
		line-height: 1.3;
		color: var(--color-text-primary);
	}

	.ck-cat-card:not(.is-open) .ck-cat-head h3 {
		color: var(--color-text-secondary);
	}

	.ck-cat-badge {
		flex-shrink: 0;
		padding: 0.15rem 0.5rem;
		border-radius: 999px;
		border: 1px solid var(--color-border);
		font-size: 0.6875rem;
		font-weight: 650;
		white-space: nowrap;
		color: var(--color-text-muted);
	}

	.ck-cat-badge.is-open {
		background: var(--color-accent-soft);
		border-color: transparent;
		color: var(--color-accent);
	}

	.ck-cat-card p {
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--color-text-secondary);
	}

	.ck-cat-go {
		margin-top: auto;
		padding-top: 0.35rem;
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--color-accent);
	}

	.ck-cat-card.is-open:hover .ck-cat-go span {
		display: inline-block;
		transform: translateX(2px);
		transition: transform 150ms ease;
	}
</style>
