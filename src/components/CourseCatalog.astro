---
/**
 * CourseCatalog — the course list on `/curriculum/`.
 *
 * A grid rather than a full-width vertical list: a list of wide rows reads as
 * "endless" once there are more than about four, and a grid stays scannable up
 * to roughly eight. Past that, the header nav and the per-course sidebar are
 * the real navigation and this becomes a shortcut, not the index.
 *
 * **Only open courses get a card.** Planned ones used to render as dashed cards
 * in the same grid, which at launch meant three quarters of this page was
 * placeholder — the page read as an empty site rather than a small one. They
 * are named in a single line underneath instead: still honest about where the
 * project is going, without giving a plan the same footprint as a course
 * somebody can actually read. As a course opens it moves from that line into
 * the grid, and when the last one does the line disappears on its own.
 *
 * Lesson counts come from the collection, so the grid cannot drift out of date.
 */
import { getCollection } from 'astro:content';
import { COURSES } from '../lib/courses';
import { listSentence } from '../lib/format';

const lessons = await getCollection('docs', ({ data }) => Boolean(data.lesson));

// Count lessons and weeks, not pages — a four-part lesson is one lesson.
const lessonKeys = new Map<string, Set<string>>();
const weekNums = new Map<string, Set<number>>();
for (const page of lessons) {
	const { course, kind, kindNumber, week } = page.data.lesson!;
	if (!lessonKeys.has(course)) lessonKeys.set(course, new Set());
	if (!weekNums.has(course)) weekNums.set(course, new Set());
	lessonKeys.get(course)!.add(`${kind}-${kindNumber}`);
	weekNums.get(course)!.add(week);
}

// A course is readable only if it is marked open *and* actually has lessons —
// a course flipped to open before anything is written would otherwise link to
// an empty outline.
const isReadable = (slug: string, status: string) =>
	status === 'open' && (lessonKeys.get(slug)?.size ?? 0) > 0;

const open = COURSES.filter((c) => isReadable(c.slug, c.status));
const planned = COURSES.filter((c) => !isReadable(c.slug, c.status));

// "Private Pilot — Helicopter" reads as a title; in a run-on sentence the
// qualifier is noise, so trim it: "Instrument, Commercial and Flight Instructor".
const plannedNames = planned.map((c) => c.title.replace(/\s*—\s*Helicopter$/, ''));
---

<ul class="ck-cat not-content">
	{
		open.map((course) => {
			const n = lessonKeys.get(course.slug)?.size ?? 0;
			const w = weekNums.get(course.slug)?.size ?? 0;
			return (
				<li>
					<a class="ck-card ck-cat-card" href={course.href}>
						<div class="ck-cat-head">
							<h3>{course.title}</h3>
							<span class="ck-cat-badge">
								{n} lesson{n === 1 ? '' : 's'}
								{w > 0 ? ` · ${w} week${w === 1 ? '' : 's'}` : ''}
							</span>
						</div>
						<p>{course.blurb}</p>
						<span class="ck-cat-foot">
							<span class="ck-cat-open">Open course</span>
							<span class="ck-card-go" aria-hidden="true">→</span>
						</span>
					</a>
				</li>
			);
		})
	}
</ul>

{
	plannedNames.length > 0 && (
		<p class="ck-cat-planned not-content">
			{listSentence(plannedNames)} {plannedNames.length === 1 ? 'is' : 'are'} planned.
		</p>
	)
}

<style>
	/*
	 * Intentionally breakpoint-free. `auto-fit` + `minmax` already gives one
	 * column on a phone, two on a tablet and three on a wide desktop, and it
	 * does it against the *container* rather than the viewport — so it stays
	 * right inside the content column whatever the sidebar is doing.
	 *
	 * Do not convert this to media queries. An intrinsic layout that needs no
	 * breakpoint is better than one that has them; reach for `theme()` only
	 * where the layout genuinely cannot work this out for itself.
	 */
	.ck-cat {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1rem;
		/*
		 * The `1fr` max used to be here, which stretched a single course across
		 * the whole content column — a 1,200px card holding a title and one line
		 * of blurb reads as an empty page rather than a small catalog. Capped at
		 * 24rem the card keeps a card's proportions at any count, and the grid
		 * still needs no breakpoint: `auto-fit` packs as many as fit and wraps.
		 */
		grid-template-columns: repeat(auto-fit, minmax(17rem, 24rem));
		justify-content: start;
		text-align: start;
	}

	.ck-cat li {
		margin: 0;
		display: flex;
	}

	/*
	 * Layout only — the surface, border, elevation and hover all come from
	 * `.ck-card` in global.css, so the four card surfaces on the site cannot
	 * drift apart again.
	 */
	.ck-cat-card {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		width: 100%;
		padding: 1.35rem 1.4rem 1.15rem;
		border-radius: var(--ck-r-lg);
	}

	.ck-cat-planned {
		margin: 1.5rem 0 0;
		font-size: 0.8125rem;
		color: var(--color-text-muted);
	}

	/*
	 * Stacked, not title-left / badge-right. Side by side, a course title and
	 * "2 lessons · 1 week" fight for a 24rem card and the title loses — it wrapped
	 * to two lines while the badge sat on one. The badge below it reads as what
	 * it is, a label on the course, and the title gets the full width.
	 */
	.ck-cat-head {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.45rem;
	}

	.ck-cat-head h3 {
		margin: 0;
		border: 0;
		padding: 0;
		font-size: 1.125rem;
		font-weight: 650;
		letter-spacing: -0.02em;
		line-height: 1.25;
		color: var(--color-text-primary);
	}

	.ck-cat-badge {
		flex-shrink: 0;
		padding: 0.15rem 0.5rem;
		border-radius: 999px;
		border: 1px solid transparent;
		background: var(--color-accent-soft);
		font-size: 0.6875rem;
		font-weight: 650;
		white-space: nowrap;
		color: var(--color-accent);
	}

	.ck-cat-card p {
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--color-text-secondary);
	}

	.ck-cat-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: auto;
		padding-top: 0.75rem;
	}

	.ck-cat-open {
		font-size: 0.8125rem;
		font-weight: 650;
		color: var(--color-accent);
	}
</style>
