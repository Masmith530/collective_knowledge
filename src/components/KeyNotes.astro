---
/**
 * KeyNotes — the condensed takeaways for a lesson.
 *
 * Deliberately a wrapper around authored content rather than a list prop:
 * key notes are prose worth writing carefully, and they often need links,
 * bold terms, and the occasional nested list.
 *
 * Usage:
 *   <KeyNotes>
 *   - Low rotor RPM is recovered with **down collective, throttle on**.
 *   </KeyNotes>
 */
interface Props {
	/** Override the heading, e.g. "Memory Items". */
	title?: string;
}

const { title = 'Key Notes' } = Astro.props;
---

<aside class="ck-keynotes" aria-label={title}>
	<p class="ck-keynotes-title">
		<svg
			xmlns="http://www.w3.org/2000/svg"
			width="15"
			height="15"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2Z"></path>
		</svg>
		{title}
	</p>
	<div class="ck-keynotes-body">
		<slot />
	</div>
</aside>

<style>
	.ck-keynotes {
		margin: 2rem 0;
		padding: 1.1rem 1.35rem;
		border: 1px solid color-mix(in srgb, var(--color-accent) 30%, var(--color-border));
		border-radius: 8px;
		background: var(--color-accent-soft);
	}

	.ck-keynotes-title {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin: 0 0 0.6rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.ck-keynotes-body :global(> :first-child) {
		margin-top: 0;
	}

	.ck-keynotes-body :global(> :last-child) {
		margin-bottom: 0;
	}

	.ck-keynotes-body :global(ul),
	.ck-keynotes-body :global(ol) {
		padding-left: 1.2rem;
	}

	.ck-keynotes-body :global(li + li) {
		margin-top: 0.35rem;
	}
</style>
