---
/**
 * CourseContents — the course outline, grouped by week.
 *
 * Weeks are the unit students plan around, and they are where ground and
 * maneuver lessons interleave. Multi-part lessons list their parts beneath them
 * so a reader sees "4 parts" rather than four unrelated pages.
 */
import CourseProgress from './CourseProgress.tsx';
import { getCourseOutline, allPageIds } from '../lib/lessons';

interface Props {
	course: string;
}

const { course } = Astro.props;
const weeks = await getCourseOutline(course);
const pageIds = allPageIds(weeks);
---

{
	weeks.length === 0 ? (
		<p class="ck-cc-empty not-content">No lessons in this course yet.</p>
	) : (
		<>
			<CourseProgress lessonIds={pageIds} client:load />

			<div class="ck-cc not-content">
				{weeks.map((week) => (
					<section class="ck-cc-week">
						<h2>Week {week.week}</h2>

						<ul>
							{week.lessons.map((lesson) => (
								<li class="ck-card ck-cc-row">
									<a
										href={lesson.href}
										class="ck-cc-item"
										data-ck-lesson={lesson.parts.length === 0 ? lesson.href : undefined}
									>
										<span class:list={['ck-cc-kind', `is-${lesson.kind}`]}>{lesson.label}</span>
										<span class="ck-cc-text">
											<span class="ck-cc-title">{lesson.title}</span>
											{lesson.description && <span class="ck-cc-desc">{lesson.description}</span>}
											{lesson.parts.length > 0 && (
												<span class="ck-cc-desc">
													{lesson.parts.length} parts
													{lesson.duration ? ` · ${lesson.duration}` : ''}
												</span>
											)}
										</span>
										{lesson.parts.length === 0 && lesson.duration && (
											<span class="ck-cc-dur">{lesson.duration}</span>
										)}
										<span class="ck-card-go" aria-hidden="true">›</span>
									</a>

									{lesson.parts.length > 0 && (
										<ol class="ck-cc-parts">
											{lesson.parts.map((part) => (
												<li>
													<a href={part.href} class="ck-cc-part" data-ck-lesson={part.href}>
														<span class="ck-cc-partn">{part.part}</span>
														<span>{part.title}</span>
													</a>
												</li>
											))}
										</ol>
									)}
								</li>
							))}
						</ul>
					</section>
				))}
			</div>
		</>
	)
}

<script>
	import { watchCompletions } from '../lib/completion-marks';

	/*
	 * Tick the pages this reader has finished. One shared implementation —
	 * this component used to carry its own copy of the loop, reading storage
	 * directly, as did two others.
	 */
	watchCompletions();
</script>

<style>
	@reference "../styles/global.css";

	.ck-cc-week + .ck-cc-week {
		margin-top: 2.25rem;
	}

	.ck-cc-week h2 {
		margin: 0 0 0.75rem;
		border: 0;
		padding: 0;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.ck-cc ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}

	/*
	 * Surface, border, elevation and hover come from `.ck-card`. This adds only
	 * what is specific to an outline row: the clip that keeps the parts list
	 * inside the rounded corner.
	 */
	.ck-cc-row {
		margin: 0;
		overflow: hidden;
	}

	.ck-cc-item {
		display: flex;
		align-items: flex-start;
		gap: 0.9rem;
		padding: 1.05rem 1.25rem;
		text-decoration: none;
	}

	/* Nudged down so it sits on the title's line rather than the row's top
	   edge, which on a two-line lesson left it floating. */
	.ck-cc-item .ck-card-go {
		align-self: flex-start;
		padding-top: 0.05rem;
		font-size: 1.15rem;
		line-height: 1.2;
	}

	.ck-cc-kind {
		flex-shrink: 0;
		min-width: 4.6rem;
		padding: 0.18rem 0.5rem;
		border-radius: 6px;
		background: var(--color-accent-soft);
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		text-align: center;
		color: var(--color-accent);
		white-space: nowrap;
	}

	/* Flight and sim lessons read differently at a glance from ground lessons. */
	.ck-cc-kind.is-flight {
		background: var(--color-ok-soft);
		color: var(--color-ok);
	}

	.ck-cc-kind.is-sim {
		background: var(--color-warn-soft);
		color: var(--color-warn);
	}

	.ck-cc-text {
		flex: 1;
		min-width: 0;
	}

	.ck-cc-title {
		display: block;
		font-size: 1.0625rem;
		font-weight: 650;
		letter-spacing: -0.015em;
		color: var(--color-text-primary);
		line-height: 1.4;
	}

	.ck-cc-item[data-ck-done] .ck-cc-title::after,
	.ck-cc-part[data-ck-done]::after {
		content: '✓';
		margin-inline-start: 0.45rem;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--color-ok);
	}

	.ck-cc-desc {
		display: block;
		margin-top: 0.3rem;
		font-size: 0.8125rem;
		line-height: 1.55;
		color: var(--color-text-secondary);
	}

	.ck-cc-dur {
		flex-shrink: 0;
		font-size: 0.75rem;
		color: var(--color-text-muted);
		white-space: nowrap;
		padding-top: 0.2rem;
	}

	/*
	 * A hairline above the parts, and a quieter ground than the card, so the
	 * summary and the list of pages read as two things. Without it the parts
	 * ran straight on from the description and the card had no internal shape.
	 */
	.ck-cc-parts {
		list-style: none;
		margin: 0;
		padding: 0.5rem 0.6rem 0.6rem 6.4rem;
		gap: 0.1rem;
		border-top: 1px solid var(--color-border-muted);
		background: var(--color-canvas-subtle);
	}

	.ck-cc-part {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.4rem 0.55rem;
		border-radius: var(--ck-r-sm);
		font-size: 0.875rem;
		text-decoration: none;
		color: var(--color-text-secondary);
		transition: background 120ms ease, color 120ms ease;
	}

	.ck-cc-part:hover {
		background: var(--color-surface);
		color: var(--color-text-primary);
	}

	.ck-cc-partn {
		flex-shrink: 0;
		width: 1.2rem;
		height: 1.2rem;
		display: grid;
		place-items: center;
		border-radius: 4px;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		font-size: 0.65rem;
		font-weight: 700;
		color: var(--color-text-muted);
	}

	.ck-cc-empty {
		color: var(--color-text-muted);
	}

	/* ─── RESPONSIVE ───────────────────────────────────────
	   The outline is the densest layout on the site: a fixed-width kind chip, a
	   title, a description and a duration on one row. */

	/* Phones and small tablets. The duration goes first — it is the least
	   load-bearing thing in the row, and dropping it buys the title a line. The
	   parts list loses its deep indent, which existed only to line up under the
	   chip. */
	@media (width < theme(--breakpoint-sm)) {
		.ck-cc-dur {
			display: none;
		}

		.ck-cc-parts {
			padding-left: 1.1rem;
		}
	}

	/* Narrow phones. A 4.6rem chip beside a title leaves roughly 11rem for the
	   title at 320px, which breaks most lesson names across three lines. Put the
	   chip on its own line above the title instead. */
	@media (width < theme(--breakpoint-xs)) {
		.ck-cc-item {
			flex-direction: column;
			gap: 0.5rem;
			padding: 0.9rem 1rem;
		}

		.ck-cc-kind {
			min-width: 0;
			align-self: flex-start;
			padding-inline: 0.45rem;
		}

		/* The row is a flex column at this width, so the chevron became a block
		   of its own under the meta line. Pinned to the card's top corner
		   instead — `.ck-card` is the positioned ancestor — opposite the kind
		   chip, where it still reads as "this row goes somewhere". */
		.ck-cc-item .ck-card-go {
			position: absolute;
			top: 0.75rem;
			inset-inline-end: 1rem;
			padding-top: 0;
		}

		.ck-cc-parts {
			padding: 0 0.5rem 0.5rem 0.9rem;
		}
	}
</style>
