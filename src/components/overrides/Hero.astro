---
/**
 * Hero override.
 *
 * Says what the site *is* — free, open, community-written training for
 * helicopter pilots and the people teaching them. It deliberately does not
 * pitch the pedagogy: "learn it in building blocks" was selling a method to
 * someone who has not yet decided to be here, and the method shows itself once
 * they are reading a course.
 *
 * Both actions point at index pages rather than a specific course, so neither
 * goes stale as courses are added.
 */
---

<section class="ck-hero">
	<p class="ck-eyebrow">
		<span class="ck-dot" aria-hidden="true"></span>
		Community built · Open source · Always free
	</p>

	<h1>Free, open flight training<br class="ck-br" /> for helicopter pilots.</h1>

	<p class="ck-sub">
		Community-written ground courses for student pilots — and for the instructors
		teaching them. No accounts, no ads, no paywalls.
	</p>

	<div class="ck-actions">
		<a href="/curriculum/" class="ck-btn ck-btn-primary">Browse courses</a>
		<a href="/subjects/" class="ck-btn ck-btn-secondary">View subject areas</a>
	</div>
</section>

<style>
	.ck-hero {
		max-width: 46rem;
		margin: 0 auto;
		padding: clamp(3rem, 10vmin, 6rem) 0 clamp(1rem, 3vmin, 2rem);
		text-align: center;
	}

	.ck-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		margin: 0 0 1.15rem;
		padding: 0.28rem 0.8rem;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: var(--color-canvas-subtle);
		font-size: 0.75rem;
		font-weight: 550;
		color: var(--color-text-secondary);
	}

	.ck-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--color-ok);
		flex-shrink: 0;
	}

	.ck-hero h1 {
		margin: 0;
		font-size: clamp(2.1rem, 5.4vw, 3.25rem);
		font-weight: 700;
		line-height: 1.08;
		letter-spacing: -0.035em;
		color: var(--color-text-primary);
	}

	.ck-sub {
		margin: 1.15rem auto 0;
		max-width: 34rem;
		font-size: 1.0625rem;
		line-height: 1.65;
		color: var(--color-text-secondary);
	}

	.ck-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.6rem;
		margin-top: 1.85rem;
	}

	.ck-br {
		display: none;
	}

	@media (min-width: 40rem) {
		.ck-br {
			display: inline;
		}
	}
</style>
