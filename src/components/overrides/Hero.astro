---
// src/components/overrides/Hero.astro
// Replaces Starlight's hero with a full-bleed, centered homepage intro
---

<section class="ck-hero">
  <div class="ck-hero-inner">
    <p class="ck-eyebrow">Rotary-Wing Ground School</p>
    <h1 class="ck-title">
      Built for pilots who<br />take their training seriously.
    </h1>
    <p class="ck-subtitle">
      A free, community-driven training reference for helicopter student pilots,
      commercial candidates, and flight instructors. Clear aeronautical theory,
      practical maneuver guides, and interactive study tools — no paywalls, ever.
    </p>
    <div class="ck-actions">
      <a href="/aerodynamics/principles/" class="ck-btn-primary">Start Learning</a>
      <a href="#modules" class="ck-btn-ghost">View Curriculum</a>
    </div>
  </div>
</section>

<style>
  .ck-hero {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(5rem, 14vmin, 10rem) 1.5rem clamp(4rem, 10vmin, 7rem);
    text-align: center;
  }

  .ck-hero-inner {
    max-width: 720px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  /* Eyebrow label */
  .ck-eyebrow {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  /* Headline */
  .ck-title {
    margin: 0;
    font-family: var(--font-display, 'Playfair Display', Georgia, serif);
    font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--color-text-primary);
  }

  /* Subtitle */
  .ck-subtitle {
    margin: 0;
    font-size: clamp(1rem, 1.8vw, 1.125rem);
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 58ch;
  }

  /* CTA row */
  .ck-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 0.5rem;
  }

  .ck-btn-primary,
  .ck-btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 1.5rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: all 150ms ease;
    white-space: nowrap;
  }

  .ck-btn-primary {
    background: var(--color-accent);
    color: #fff;
    border: 1px solid transparent;
  }

  .ck-btn-primary:hover {
    opacity: 0.88;
  }

  .ck-btn-ghost {
    background: transparent;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
  }

  .ck-btn-ghost:hover {
    background: var(--color-canvas-subtle);
    color: var(--color-text-primary);
    border-color: var(--color-text-muted);
  }
</style>
