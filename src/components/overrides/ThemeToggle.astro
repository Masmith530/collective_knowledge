---
// src/components/overrides/ThemeToggle.astro
// A clean icon-only dark/light toggle button
---

<button
  id="ck-theme-toggle"
  type="button"
  aria-label="Toggle theme"
  title="Toggle light / dark theme"
>
  <!-- Sun icon (shown in dark mode → click to go light) -->
  <svg id="ck-icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
  </svg>
  <!-- Moon icon (shown in light mode → click to go dark) -->
  <svg id="ck-icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
  </svg>
</button>

<style>
  #ck-theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: background 150ms ease, color 150ms ease, border-color 150ms ease;
    flex-shrink: 0;
  }

  #ck-theme-toggle:hover {
    background: var(--color-canvas-subtle);
    color: var(--color-text-primary);
    border-color: var(--color-text-muted);
  }

  /* Show only the appropriate icon per theme */
  :root[data-theme='dark'] #ck-icon-moon   { display: none; }
  :root[data-theme='dark'] #ck-icon-sun    { display: block; }
  :root[data-theme='light'] #ck-icon-sun   { display: none; }
  :root[data-theme='light'] #ck-icon-moon  { display: block; }
</style>

<script>
  function initToggle() {
    const btn = document.getElementById('ck-theme-toggle');
    if (!btn) return;

    function getStored(): 'dark' | 'light' {
      const v = localStorage.getItem('starlight-theme');
      return v === 'light' ? 'light' : 'dark';
    }

    function apply(theme: 'dark' | 'light') {
      document.documentElement.dataset.theme = theme;
      localStorage.setItem('starlight-theme', theme);
    }

    // Apply on load in case Starlight hasn't set it yet
    apply(getStored());

    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      apply(next);
    });
  }

  initToggle();
  document.addEventListener('astro:page-load', initToggle);
</script>
