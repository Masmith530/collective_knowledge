---
/**
 * Icon-only light/dark toggle. Light is the default; see ThemeProvider.astro.
 */
---

<button id="ck-theme-toggle" type="button" aria-label="Switch between light and dark theme">
	<svg
		class="ck-icon-sun"
		xmlns="http://www.w3.org/2000/svg"
		width="17"
		height="17"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
	</svg>
	<svg
		class="ck-icon-moon"
		xmlns="http://www.w3.org/2000/svg"
		width="17"
		height="17"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
	</svg>
</button>

<style>
	#ck-theme-toggle {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border-radius: var(--ck-r-sm);
		border: 1px solid transparent;
		background: transparent;
		color: var(--color-text-secondary);
		cursor: pointer;
		flex-shrink: 0;
		transition: background 130ms ease, color 130ms ease;
	}

	#ck-theme-toggle:hover {
		background: var(--color-canvas-subtle);
		border-color: var(--color-border);
		color: var(--color-text-primary);
	}

	#ck-theme-toggle svg {
		grid-area: 1 / 1;
	}

	/* Show the icon for the theme you'd switch TO. */
	:root[data-theme='dark'] .ck-icon-moon,
	:root[data-theme='light'] .ck-icon-sun {
		display: none;
	}
</style>

<script>
	function initThemeToggle() {
		const btn = document.getElementById('ck-theme-toggle');
		if (!btn || btn.dataset.ckBound) return;
		btn.dataset.ckBound = '1';

		btn.addEventListener('click', () => {
			const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
			document.documentElement.dataset.theme = next;
			try {
				localStorage.setItem('starlight-theme', next);
			} catch {
				// Storage blocked — the theme still applies for this page view.
			}
		});
	}

	initThemeToggle();
	document.addEventListener('astro:page-load', initThemeToggle);
</script>
