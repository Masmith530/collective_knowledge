---
/**
 * Sidebar override — context aware.
 *
 * Starlight renders one global sidebar everywhere, which is wrong here: inside
 * a course you want that course's outline, inside Subject Areas you want the
 * subject list, and on `/curriculum/` itself you want the course list.
 *
 * Three things to know before editing:
 *
 * 1. The bottom block is pinned to the bottom edge and sits OUTSIDE the branch,
 *    so every section gets it. It holds a single jump to the other section
 *    (drawer only — above `nav` the header carries both, and two section navs
 *    on one screen is the thing being avoided) and then the site-information
 *    links. It is a jump naming where it goes, not a "← back" link: you can
 *    reach Subject Areas straight from the home page, so "← Curriculum" offered
 *    to send you back somewhere you had never been.
 *
 * 2. The site-information pages render BOTH outlines and reveal one, so that
 *    clicking a pinned footer link does not rearrange the sidebar you clicked
 *    it in. See the dual-section note on the markup.
 *
 * 3. Within a course, lessons with parts are collapsed and only the current one
 *    is expanded — the full outline expanded at once was too tall to navigate.
 *    Subject areas stay expanded because they are only two levels deep.
 */
import { COURSES } from '../../lib/courses';
import { getSubjectOutline } from '../../lib/subjects';
import { getCourseOutline } from '../../lib/lessons';

const path = Astro.url.pathname;
const inSubjects = path.startsWith('/subjects/');
// The catalog page itself lists courses rather than one course's outline.
const atCatalog = path === '/curriculum/';
// Site-information pages belong to neither section. Without a branch of their
// own they fell through to the course outline, where `?? openCourses[0]` picked
// the first open course — so opening the disclaimer from anywhere on the site
// dumped you into the Private Pilot outline.
const inStartHere = path.startsWith('/start-here/');

const SITE_PAGES = [
	{ href: '/start-here/why-this-is-free/', label: 'Why this is free' },
	{ href: '/start-here/disclaimer/', label: 'Disclaimer & licensing' },
];
// Only open courses are navigable — a planned course has no page to link to.
const openCourses = COURSES.filter((c) => c.status === 'open');

// ─── Course outlines ───
//
// The course you are in, if any. Deliberately not `?? openCourses[0]`: that
// fallback is what showed the Private Pilot outline from anywhere on the site,
// and it would do the same to a reader who had only ever seen the course list.
const currentCourse = COURSES.find((c) => path.startsWith(c.href));

// ─── Subject areas ───
//
// Three levels now: area → airframe group → article, and an article may itself
// have parts. Built by `getSubjectOutline()` so this cannot disagree with the
// subject index about which article sits under which airframe.
const areas = await getSubjectOutline();

// A "General" heading above the only group in an area labels nothing. It earns
// its place as soon as an area holds both general and airframe-specific
// articles, which is the distinction a reader most needs to see.
const showGroups = (groups: { general: boolean }[]) =>
	groups.length > 1 || !groups[0]?.general;

const here = (href: string) => path === href;

/*
 * ─── Views ───
 *
 * A view is one sidebar: the course list, one course's outline, or the subject
 * list. Almost every page is exactly one of them. The site-information pages
 * are none, so they render every view and reveal the one the reader came from.
 *
 * **Courses is two kinds of view, not one**, and collapsing them was a bug.
 * `/curriculum/` shows the course *list*; inside a course you get that course's
 * outline. Remembering only "you were in Courses" therefore handed the course
 * outline to a reader who had never opened a course — the same wrong-outline
 * problem as before, one level up. A view id is as specific as the sidebar it
 * names: `catalog`, `course:<slug>`, or `subjects`.
 */
const courseView = (slug: string) => `course:${slug}`;

const views: string[] = inStartHere
	? ['catalog', ...openCourses.map((c) => courseView(c.slug)), 'subjects']
	: inSubjects
		? ['subjects']
		: currentCourse
			? [courseView(currentCourse.slug)]
			: ['catalog'];

/*
 * What a reader sees with no JavaScript, on a cold visit, or from a shared
 * link. For the site-information pages that is the course *list*, not a course:
 * it is the section index, it assumes nothing about the reader, and every
 * course is one click from it.
 */
const defaultView = views[0];
const dual = views.length > 1;
/** The view this page *is*, for the recorder. Null when the page is no view. */
const currentView = dual ? null : defaultView;

// Every open course on the site-information pages, the one you are in
// otherwise, and none on the course list itself.
const courseOutlines = await Promise.all(
	(inStartHere ? openCourses : currentCourse ? [currentCourse] : []).map(async (c) => ({
		course: c,
		weeks: await getCourseOutline(c.slug),
	})),
);

/*
 * The jump at the bottom names the section you are not in, so it is keyed by
 * section rather than view — every course view jumps to Subject Areas. Drawer
 * only: above `nav` the header carries both.
 */
const sectionOf = (view: string) => (view === 'subjects' ? 'subjects' : 'courses');

const SECTION_JUMP = {
	courses: { label: 'Subject Areas', href: '/subjects/' },
	subjects: { label: 'Courses', href: '/curriculum/' },
} as const;

const jumpSections = [...new Set(views.map(sectionOf))];
const defaultJump = sectionOf(defaultView);
---

<nav
	class="ck-sb"
	aria-label="Site navigation"
	data-ck-dual={dual ? '' : undefined}
	data-ck-view-self={currentView ?? undefined}
>
	<div class="ck-sb-main">
	{/*
	  One block per view. Most pages render exactly one, so its wrapper is
	  transparent (`display: contents`) and nothing below it notices. The
	  site-information pages render them all and reveal one — see `views`.
	*/}
	{views.includes('catalog') && (
		<div
			class="ck-sb-sect"
			data-ck-view="catalog"
			data-ck-default={defaultView === 'catalog' ? '' : undefined}
		>
				<p class="ck-sb-course">All courses</p>
				<ul>
					{openCourses.map((c) => (
						<li>
							<a
								href={c.href}
								class="ck-sb-link"
								aria-current={here(c.href) ? 'page' : undefined}
							>
								{c.title}
							</a>
						</li>
					))}
				</ul>
		</div>
	)}

	{courseOutlines.map(({ course, weeks }) => (
		<div
			class="ck-sb-sect"
			data-ck-view={`course:${course.slug}`}
			data-ck-default={defaultView === `course:${course.slug}` ? '' : undefined}
		>
				{/*
				  Up one level. Without it there is no way back to the course list
				  from inside a course: "Course overview" only goes up to this
				  course's own page, and the jump at the bottom goes to the other
				  *section*, not to the courses index.
				*/}
				<a href="/curriculum/" class="ck-sb-link ck-sb-up">
					<span class="ck-sb-up-arrow" aria-hidden="true">←</span>
					All courses
				</a>

				<p class="ck-sb-course">{course?.title}</p>
				{course && (
					<a
						href={course.href}
						class="ck-sb-link ck-sb-top"
						aria-current={here(course.href) ? 'page' : undefined}
					>
						Course overview
					</a>
				)}

				{weeks.map((week) => (
					<div class="ck-sb-group">
						<p class="ck-sb-heading">Week {week.week}</p>
						<ul>
							{week.lessons.map((lesson) => {
								const split = lesson.parts.length > 0;
								// `lesson.href` is the lesson itself, or its first part.
								// `pageIds` is completable pages only, so the overview page —
							// which is deliberately not one — has to be named separately
							// or standing on it would collapse the lesson's part list.
							const inThisLesson =
								lesson.pageIds.includes(path) || lesson.overviewHref === path;
								return (
									<li>
										<a
											href={lesson.href}
											class="ck-sb-link ck-sb-lesson"
											/*
											 * No `data-ck-lesson` here, deliberately. The ✓ it draws is a `::after`
											 * on the link, and this link is a flex *column* — so on a finished
											 * single-page lesson the tick landed as a third row under the title
											 * instead of beside it. Every lesson row reports through the badge
											 * below instead, which also makes a one-page lesson and a four-part
											 * one look alike.
											 */
											// Exactly one element may be aria-current="page". For a
											// split lesson that is the part you are on, not this row —
											// the row gets the generic "true", meaning "the lesson you
											// are in". It links to part 1, so on part 1 that is a link
											// to the current page and needs to say so.
											aria-current={
												!split && here(lesson.href)
													? 'page'
													: split && inThisLesson
														? 'true'
														: undefined
											}
											data-ck-in={split && inThisLesson ? '' : undefined}
										>
											<span class="ck-sb-kind">{lesson.label}</span>
											<span class="ck-sb-lrow">
												<span class="ck-sb-ltitle">{lesson.title}</span>
												{/*
												  One status badge on every lesson row, whatever its shape. "4 parts" was
												  a fact about the lesson; a reader wants a fact about themselves. The
												  part count survives as the denominator.

												  `pageIds` is the right input rather than `parts`: it is the lesson's
												  completable pages either way — the four parts, or the single page a
												  one-page lesson consists of — so both kinds report the same way, and a
												  row does not change shape on the day a lesson is split into parts. The
												  fraction shows only when there is more than one page to count; "1/1"
												  says nothing the filled ring does not.

												  Server-rendered at zero, which is honest: progress is read from the
												  device and the server has none. A reader with no JavaScript has no
												  saved progress either, so an empty ring is the truth for them and
												  stays the truth.

												  The ring and the fraction are decoration; the visually-hidden sentence
												  is the real text, because "2/4" out of context reads as nothing and an
												  empty ring reads as less than that.
												*/}
												{lesson.pageIds.length > 0 && (
													<span
														class="ck-sb-prog"
														data-ck-parts={lesson.pageIds.join(' ')}
														data-ck-prog="none"
													>
														<span class="ck-sb-ring" aria-hidden="true" />
														{lesson.pageIds.length > 1 && (
															<span class="ck-sb-count" aria-hidden="true">0/{lesson.pageIds.length}</span>
														)}
														<span class="sr-only">Not started</span>
													</span>
												)}
											</span>
										</a>

										{/*
										  Parts appear only for the lesson you are actually in.
										  Clicking a lesson takes you to its first part, which is
										  what opens this list — one click to start a lesson,
										  instead of expanding a disclosure and then clicking
										  again. The whole outline expanded at once was too tall
										  to navigate, which is the constraint that has not
										  changed.
										*/}
										{split && inThisLesson && (
											<ul class="ck-sb-parts">
												{lesson.parts.map((part) => (
													<li>
														<a
															href={part.href}
															class="ck-sb-link ck-sb-part"
															data-ck-lesson={part.href}
															aria-current={here(part.href) ? 'page' : undefined}
														>
															<span class="ck-sb-partn">{part.part}</span>
															<span>{part.title}</span>
														</a>
													</li>
												))}
											</ul>
										)}
									</li>
								);
							})}
						</ul>
					</div>
				))}

				{weeks.length === 0 && <p class="ck-sb-empty">No lessons yet.</p>}
		</div>
	))}

	{views.includes('subjects') && (
		<div
			class="ck-sb-sect"
			data-ck-view="subjects"
			data-ck-default={defaultView === 'subjects' ? '' : undefined}
		>
				<a href="/subjects/" class="ck-sb-link ck-sb-top" aria-current={here('/subjects/') ? 'page' : undefined}>
					All subject areas
				</a>

				{areas.map((area) => (
					<div class="ck-sb-group">
						<p class="ck-sb-heading">{area.label}</p>

						{area.groups.map((group) => (
							<div class="ck-sb-sub">
								{showGroups(area.groups) && (
									<p class="ck-sb-subheading">{group.label}</p>
								)}
								<ul>
									{group.articles.map((item) => {
										const split = item.parts.length > 0;
										const inThisArticle =
											item.pageIds.includes(path) || item.overviewHref === path;
										return (
											<li>
												<a
													href={item.href}
													class="ck-sb-link"
													/*
													 * Only a single-page article is itself a page that can
													 * be read; a split article's ticks belong to its parts,
													 * and the row would wear the ✓ on its own line.
													 */
													data-ck-lesson={split ? undefined : item.href}
													aria-current={
														!split && here(item.href)
															? 'page'
															: split && inThisArticle
																? 'true'
																: undefined
													}
													data-ck-in={split && inThisArticle ? '' : undefined}
												>
													{item.title}
												</a>

												{/*
												  Parts appear only for the article you are in — the same
												  rule the course outline follows, and the reason three
												  levels of subject navigation stay navigable. Expanding
												  every article at once is what made the course outline
												  unusable before.
												*/}
												{split && inThisArticle && (
													<ul class="ck-sb-parts">
														{item.parts.map((part) => (
															<li>
																<a
																	href={part.href}
																	class="ck-sb-link ck-sb-part"
																	data-ck-lesson={part.href}
																	aria-current={here(part.href) ? 'page' : undefined}
																>
																	<span class="ck-sb-partn">{part.part}</span>
																	<span>{part.title}</span>
																</a>
															</li>
														))}
													</ul>
												)}
											</li>
										);
									})}
								</ul>
							</div>
						))}
					</div>
				))}

				{areas.length === 0 && <p class="ck-sb-empty">No articles yet.</p>}
		</div>
	)}
	</div>

	{/*
	  Pinned to the bottom of the sidebar (`margin-top: auto`), not trailing the
	  outline. When the outline is short this sits on the bottom edge; when it is
	  long enough to scroll, it falls below the last lesson, which is the right
	  place for it either way.

	  It is outside the branch on purpose. The fine links used to be written out
	  inside two of the three branches, which meant Subject Areas pages — the
	  third — carried no footer at all, and nobody noticed because the markup
	  looked complete in both places you were likely to read. One copy, every
	  section.
	*/}
	<div class="ck-sb-bottom">
		{/*
		  One jump per section in the markup, tagged to match its outline, so in
		  dual mode the hidden section's jump is hidden by the same selector that
		  hides its outline. Without the tag both would show and the drawer would
		  offer to send you to the section you are looking at.
		*/}
		{jumpSections.map((s) => (
			<a
				href={SECTION_JUMP[s].href}
				class="ck-sb-jump"
				data-ck-jump={s}
				data-ck-default={s === defaultJump ? '' : undefined}
			>
				<span>{SECTION_JUMP[s].label}</span>
				<span class="ck-sb-jump-arrow" aria-hidden="true">→</span>
			</a>
		))}

		{/*
		  On every page, including the site-information pages themselves — which is
		  the point: the reader stays where they were and the link they clicked
		  marks itself. Rendered from `SITE_PAGES`, the one list, so the two places
		  it appears cannot drift apart.
		*/}
		<div class="ck-sb-fines">
			{SITE_PAGES.map((p) => (
				<a
					href={p.href}
					class="ck-sb-link ck-sb-fine"
					aria-current={here(p.href) ? 'page' : undefined}
				>
					{p.label}
				</a>
			))}
		</div>
	</div>
</nav>

{
	/*
	 * Section memory — the reading half, inline and pre-paint.
	 *
	 * `is:inline` for the same reason `ThemeProvider` uses it: a bundled module is
	 * deferred, so the reader would see the Courses outline appear and then be
	 * replaced. Running here, while the parser is still working through the page,
	 * beats first paint — so the sidebar is simply correct on arrival.
	 *
	 * Rendered only where it can do something. It never reveals the default, only
	 * switches away from it, which is why no-JS and storage-denied both land on
	 * the Courses outline that is already in the markup.
	 */
	dual && (
		<script is:inline>
			try {
				var sb = document.querySelector('.ck-sb');
				var want = sessionStorage.getItem('ck-last-view');
				// Only ever a shape this component writes — never interpolate storage
				// straight into a selector.
				if (sb && want && /^[a-z0-9:-]+$/.test(want)) {
					var target = sb.querySelector('[data-ck-view="' + want + '"]');
					if (target) {
						var section = want === 'subjects' ? 'subjects' : 'courses';
						sb.querySelectorAll('[data-ck-view]').forEach(function (el) {
							el.classList.toggle('is-view', el === target);
							el.classList.toggle('is-not-view', el !== target);
						});
						sb.querySelectorAll('[data-ck-jump]').forEach(function (el) {
							var on = el.getAttribute('data-ck-jump') === section;
							el.classList.toggle('is-view', on);
							el.classList.toggle('is-not-view', !on);
						});
					}
				}
			} catch (e) {
				/* no memory available; the markup's default stands */
			}
		</script>
	)
}

<script>
	import { completions, markCompletions, onProgress } from '../../lib/completion-marks';

	/*
	 * Ticks and rings. The tick half is shared with the course contents, the
	 * subject index and a lesson's part list — four places that each used to
	 * carry their own copy of the same loop, reading storage directly.
	 *
	 * The rings are the sidebar's own: a lesson row reports how far through the
	 * lesson you are. The page paths are written on the badge rather than counted
	 * from the DOM, because a split lesson's parts are only rendered for the
	 * lesson you are actually in.
	 */
	onProgress(() => {
		const lessons = completions();
		markCompletions(document, lessons);

		for (const el of document.querySelectorAll<HTMLElement>('.ck-sb [data-ck-parts]')) {
			const pages = (el.getAttribute('data-ck-parts') ?? '').split(' ').filter(Boolean);
			if (pages.length === 0) continue;

			const done = pages.filter((href) => lessons[href]).length;
			const state = done === 0 ? 'none' : done === pages.length ? 'done' : 'some';

			el.style.setProperty('--ck-p', String(done / pages.length));
			el.setAttribute('data-ck-prog', state);

			// Absent on a single-page lesson, where "1/1" would add nothing.
			const count = el.querySelector('.ck-sb-count');
			if (count) count.textContent = `${done}/${pages.length}`;

			// The sentence a screen reader actually reads. A one-page lesson is done
			// or not; a split one is a fraction.
			const label = el.querySelector('.sr-only');
			if (label) {
				label.textContent =
					pages.length === 1
						? state === 'done'
							? 'Complete'
							: 'Not started'
						: `${done} of ${pages.length} parts complete`;
			}
		}
	});


	/*
	 * Section memory — the recording half.
	 *
	 * Every page that belongs to a section writes down which one, so the
	 * site-information pages (which belong to neither) can put that outline back.
	 * The reading half is the inline script beside the markup above, because it
	 * has to run before first paint.
	 *
	 * `sessionStorage`, not `localStorage`: this is "where was I a moment ago",
	 * which has no business surviving until next week. It is not progress, so it
	 * does not belong in `src/lib/progress.ts` — but the same rule applies and
	 * every access is wrapped. Storage throws in some private browsing modes and
	 * can be switched off altogether; a reader with it off still gets a working
	 * sidebar, just always the Courses outline on those two pages.
	 */
	const sb = document.querySelector<HTMLElement>('.ck-sb');
	const view = sb?.getAttribute('data-ck-view-self');
	if (view) {
		try {
			sessionStorage.setItem('ck-last-view', view);
		} catch {
			// Nothing to do — the site-information pages fall back to the course list.
		}
	}
</script>

<style>
	@reference "../../styles/global.css";

	/*
	 * A column that fills the sidebar's height, so the bottom block can be
	 * pinned to the bottom edge with `margin-top: auto`. Starlight's
	 * `.sidebar-content` is already `height: 100%` with `min-height: max-content`,
	 * so `flex: 1` fills a short outline and a long one simply grows and scrolls.
	 */
	.ck-sb {
		display: flex;
		flex-direction: column;
		flex: 1;
		/* Only a little bottom padding: Starlight's `.sidebar-content` is a flex
		   column with `gap: 1rem` and a trailing `::after`, so it already leaves
		   about 1rem below this nav. More here and the pinned block stops
		   looking pinned. */
		padding: 1.1rem 0 0.35rem;
		font-size: 0.875rem;
	}

	.ck-sb-main {
		flex: 0 0 auto;
	}

	.ck-sb ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.ck-sb li {
		margin: 0;
	}

	.ck-sb-course {
		margin: 0 0 0.4rem 0.6rem;
		font-size: 0.8125rem;
		font-weight: 650;
		letter-spacing: -0.01em;
		color: var(--color-text-primary);
	}

	/* ── Links ── */
	.ck-sb-link {
		display: block;
		padding: 0.4rem 0.6rem;
		border-radius: var(--ck-r-sm);
		text-decoration: none;
		line-height: 1.45;
		color: var(--color-text-secondary);
		transition: background 120ms ease, color 120ms ease;
	}

	.ck-sb-link:hover {
		background: var(--color-canvas-subtle);
		color: var(--color-text-primary);
	}

	.ck-sb-link[aria-current='page'] {
		background: var(--color-accent-soft);
		color: var(--color-accent);
		font-weight: 600;
	}

	.ck-sb-link[data-ck-done]::after {
		content: '✓';
		margin-inline-start: 0.4rem;
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--color-ok);
	}

	.ck-sb-top {
		margin-bottom: 0.25rem;
		font-size: 0.8125rem;
	}

	/* Up one level, to the course list. Quieter than the outline it sits above —
	   it is an escape hatch, not a destination you are being sold. */
	.ck-sb-up {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		margin-bottom: 0.9rem;
		font-size: 0.8125rem;
		color: var(--color-text-muted);
	}

	.ck-sb-up:hover {
		color: var(--color-accent);
	}

	.ck-sb-up-arrow {
		flex-shrink: 0;
	}

	.ck-sb-group {
		margin-top: 1rem;
	}

	.ck-sb-heading {
		margin: 0 0 0.25rem 0.6rem;
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	/* ── Lesson rows ── */
	/*
	 * The airframe inside a subject area — a third rung, so it has to read as
	 * quieter than `.ck-sb-heading` above it and louder than the article links
	 * below. Indented rather than merely restyled: at this size weight alone
	 * does not show nesting.
	 */
	.ck-sb-sub {
		margin-top: 0.5rem;
	}

	.ck-sb-subheading {
