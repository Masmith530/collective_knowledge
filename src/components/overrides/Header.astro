---
// src/components/overrides/Header.astro
// Fills Starlight's header slot. Import ThemeSelect directly.
import ThemeToggle from './ThemeToggle.astro';
---

<div class="ck-header-inner">
  <!-- Wordmark -->
  <a href="/" class="ck-wordmark" aria-label="Collective Knowledge home">
    <span class="ck-wordmark-primary">Collective</span><span class="ck-wordmark-sep">&nbsp;</span><span class="ck-wordmark-accent">Knowledge</span>
  </a>

  <!-- Right: theme toggle -->
  <div class="ck-header-right">
    <ThemeToggle />
  </div>
</div>

<style>
  .ck-header-inner {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .ck-wordmark {
    display: flex;
    align-items: baseline;
    text-decoration: none;
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
    user-select: none;
  }

  .ck-wordmark-primary {
    color: var(--color-text-primary);
  }

  .ck-wordmark-accent {
    color: var(--color-accent);
  }

  .ck-header-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
</style>
