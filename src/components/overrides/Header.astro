---
/**
 * Header override.
 *
 * Starlight's default header is site title + search + social + theme. This
 * replaces it with a wordmark, top-level section nav, and the same search and
 * theme controls.
 *
 * Note the Search import: an earlier version of this override dropped it, which
 * left Pagefind's index being built every deploy with no UI able to open it.
 * Keep it.
 */
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;

const NAV = [
	{ label: 'Courses', href: '/curriculum/', match: '/curriculum/' },
	{ label: 'Subject Areas', href: '/subjects/', match: '/subjects/' },
];
---

<div class="ck-hdr">
	<div class="ck-hdr-left">
		<a href="/" class="ck-wordmark" aria-label="Collective Knowledge — home">
			<svg viewBox="0 0 32 32" width="22" height="22" aria-hidden="true" class="ck-mark">
				<rect width="32" height="32" rx="7.5" fill="currentColor"></rect>
				<g transform="rotate(-28 16 16)">
					<line
						x1="4.6"
						y1="16"
						x2="27.4"
						y2="16"
						stroke="var(--color-canvas)"
						stroke-width="3.2"
						stroke-linecap="round"></line>
				</g>
				<circle cx="16" cy="16" r="3.9" fill="var(--color-canvas)"></circle>
				<circle cx="16" cy="16" r="1.6" fill="currentColor"></circle>
			</svg>
			<span class="ck-wordmark-text">
				<span>Collective</span><span class="ck-wordmark-accent">Knowledge</span>
			</span>
		</a>

		<nav class="ck-nav" aria-label="Sections">
			{
				NAV.map((item) => (
					<a
						href={item.href}
						class="ck-nav-link"
						/*
						  Always "true", the generic form: this is *section* nav, and it
						  marks the section you are in, not the page you are on.
						  Claiming "page" inside a lesson was plainly wrong — Courses
						  points at the index, not at where you are. It was also wrong
						  on the section index itself, where the link really is the
						  current page: so is the sidebar's "All subject areas", and
						  /subjects/ shipped two aria-current="page" elements, which
						  tells a screen reader there are two current pages.

						  The sidebar owns "page" because it is the page-level nav. On
						  /curriculum/ that leaves nothing claiming "page", which is
						  honest: the sidebar there lists courses, and none of them is
						  this page.
						*/
						aria-current={path.startsWith(item.match) ? 'true' : undefined}
					>
						{item.label}
					</a>
				))
			}
		</nav>
	</div>

	{/*
	  No source-code link here. The readers are student pilots and instructors,
	  not developers — a GitHub icon is at best noise to them, and the project is
	  not run in the open, so it would also point somewhere they cannot go.
	*/}
	<div class="ck-hdr-right">
		<div class="ck-search"><Search /></div>
		<ThemeToggle />
	</div>
</div>

{/* Reading progress. Only shown on pages that have article content. */}
<div class="ck-read-progress" aria-hidden="true"><span id="ck-read-bar"></span></div>

<style>
	@reference "../../styles/global.css";

	.ck-hdr {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: 100%;
		min-width: 0;
	}

	.ck-hdr-left {
		display: flex;
		align-items: center;
		gap: 1.75rem;
		min-width: 0;
	}

	.ck-wordmark {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		text-decoration: none;
		font-size: 0.975rem;
		font-weight: 680;
		letter-spacing: -0.025em;
		white-space: nowrap;
		color: var(--color-text-primary);
	}

	.ck-mark {
		color: var(--color-accent);
		flex-shrink: 0;
	}

	.ck-wordmark-text {
		display: flex;
		gap: 0.3em;
		min-width: 0;
		overflow: clip;
	}

	.ck-wordmark-accent {
		color: var(--color-accent);
	}

	.ck-nav {
		display: none;
		align-items: center;
		gap: 0.25rem;
	}

	.ck-nav-link {
		padding: 0.4rem 0.7rem;
		border-radius: var(--ck-r-sm);
		font-size: 0.875rem;
		font-weight: 550;
		text-decoration: none;
		color: var(--color-text-secondary);
		transition: background 120ms ease, color 120ms ease;
	}

	.ck-nav-link:hover {
		background: var(--color-canvas-subtle);
		color: var(--color-text-primary);
	}

	/* `aria-current="true"` — "you are in this section". Matched on the
	   attribute rather than its value so the highlight survives if the value
	   ever changes. */
	.ck-nav-link[aria-current] {
		background: var(--color-accent-soft);
		color: var(--color-accent);
	}

	.ck-hdr-right {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		flex-shrink: 0;
	}

	.ck-search {
		min-width: 0;
	}

	/* Reading progress sits on the header's bottom edge. */
	.ck-read-progress {
		position: absolute;
		inset-inline: 0;
		bottom: -1px;
		height: 2px;
		pointer-events: none;
	}

	.ck-read-progress > span {
		display: block;
		height: 100%;
		width: 0;
		background: var(--color-accent);
		transition: width 90ms linear;
	}

	/*
	 * RESPONSIVE
	 *
	 * `nav` is the structural breakpoint, and it is Starlight's, not ours: below
	 * it Starlight shows a fixed hamburger at the inline end and reserves header
	 * padding for it, and the sections live in the drawer (Sidebar.astro puts the
	 * section jump at its bottom). At and above it the sidebar is permanent, so
	 * the header carries the section nav instead. Putting our reveal on any
	 * other value opens a band with no section nav at all, or two.
	 */
	@media (width >= theme(--breakpoint-nav)) {
		.ck-nav {
			display: flex;
		}
	}

	/* Phones. The wordmark competes with the search field and the hamburger for
	   about 320px; the mark alone still identifies the site, and the link keeps
	   its aria-label, so nothing is lost to a screen reader. */
	@media (width < theme(--breakpoint-xs)) {
		.ck-wordmark-text {
			display: none;
		}
	}

	/* Below the sidebar switch, Starlight's search collapses to an icon-only
	   button and a fixed hamburger appears at the inline end. Three small
	   controls in a row need less gap than two wide ones. */
	@media (width < theme(--breakpoint-nav)) {
		.ck-hdr {
			gap: 0.6rem;
		}
	}
</style>

<script>
	// Reading progress across the article body. Kept out of React because it
	// runs on every page and needs no state beyond a CSS width.
	function initReadingProgress() {
		const bar = document.getElementById('ck-read-bar');
		const article = document.querySelector('.sl-markdown-content');
		if (!bar) return;

		if (!article) {
			bar.style.width = '0';
			return;
		}

		let queued = false;
		const update = () => {
			queued = false;
			const rect = article.getBoundingClientRect();
			const start = rect.top + window.scrollY;
			const span = rect.height - window.innerHeight;
			if (span <= 0) {
				bar.style.width = '0';
				return;
			}
			const pct = ((window.scrollY - start) / span) * 100;
			bar.style.width = `${Math.min(100, Math.max(0, pct))}%`;
		};

		const onScroll = () => {
			if (queued) return;
			queued = true;
			requestAnimationFrame(update);
		};

		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', onScroll, { passive: true });
		update();
	}

	initReadingProgress();
	document.addEventListener('astro:page-load', initReadingProgress);
</script>
