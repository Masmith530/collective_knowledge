---
/**
 * SubjectIndex — every subject area and its articles.
 *
 * Areas with no articles are named in a single line at the end rather than
 * rendered as empty sections, so the page shows the intended shape of the
 * reference without pretending the content exists. That line used to be a
 * heading plus five bullets with blurbs, which spent more of the page on what
 * is missing than on what is here — the same mistake the course catalog made
 * with its dashed "Planned" cards.
 *
 * Each filled area shows its article count. With one article that is barely
 * worth reading; with six areas and forty articles it is how someone sees at a
 * glance where the depth is, so it is here from the start rather than retrofitted.
 */
import { SUBJECT_AREAS, getSubjectOutline } from '../lib/subjects';
import { listSentence } from '../lib/format';

const outline = await getSubjectOutline();

const areas = SUBJECT_AREAS.map((area) => {
	const built = outline.find((o) => o.slug === area.slug);
	return {
		...area,
		groups: built?.groups ?? [],
		count: (built?.groups ?? []).reduce((n, g) => n + g.articles.length, 0),
	};
});

/*
 * A group heading is noise when there is only one group and it is the general
 * one — "General" above a list is a label for nothing. It earns its place the
 * moment an area holds both general and airframe-specific articles, which is
 * the distinction a reader most needs to see.
 */
const showGroupHeadings = (groups: { general: boolean }[]) =>
	groups.length > 1 || !groups[0]?.general;

const filled = areas.filter((a) => a.count > 0);
const planned = areas.filter((a) => a.count === 0);
---

<div class="ck-sx not-content">
	{
		filled.map((area) => (
			<section class="ck-sx-area">
				<div class="ck-sx-head">
					<h2>
						{area.label}
						<span class="ck-sx-count">
							{area.count} article{area.count === 1 ? '' : 's'}
						</span>
					</h2>
					<p>{area.blurb}</p>
				</div>

				{area.groups.map((group) => (
					<div class="ck-sx-group">
						{showGroupHeadings(area.groups) && <h3 class="ck-sx-gh">{group.label}</h3>}
						<ul>
							{group.articles.map((item) => (
								<li>
									<a
										class="ck-card"
										href={item.href}
										data-ck-lesson={item.parts.length === 0 ? item.href : undefined}
									>
										<span class="ck-sx-title">
											{item.title}
											{item.parts.length > 0 && (
												<span class="ck-sx-parts">{item.parts.length} parts</span>
											)}
										</span>
										{item.description && <span class="ck-sx-desc">{item.description}</span>}
									</a>
								</li>
							))}
						</ul>
					</div>
				))}
			</section>
		))
	}

	{
		planned.length > 0 && (
			<p class="ck-sx-planned">
				{listSentence(planned.map((a) => a.label))}{' '}
				{planned.length === 1 ? 'is' : 'are'} planned.
			</p>
		)
	}
</div>

<script>
	import { watchCompletions } from '../lib/completion-marks';

	/*
	 * Tick the pages this reader has finished. One shared implementation —
	 * this component used to carry its own copy of the loop, reading storage
	 * directly, as did two others.
	 */
	watchCompletions();
</script>

<style>
	.ck-sx {
		margin-top: 2rem;
	}

	.ck-sx-area + .ck-sx-area {
		margin-top: 2.25rem;
	}

	.ck-sx-head {
		margin-bottom: 0.8rem;
	}

	.ck-sx-head h2 {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		margin: 0;
		border: 0;
		padding: 0;
		font-size: 1.0625rem;
		font-weight: 650;
		letter-spacing: -0.015em;
		color: var(--color-text-primary);
	}

	.ck-sx-count {
		font-size: 0.6875rem;
		font-weight: 650;
		letter-spacing: 0;
		color: var(--color-text-muted);
		white-space: nowrap;
	}

	.ck-sx-head p {
		margin: 0.2rem 0 0;
		font-size: 0.875rem;
		color: var(--color-text-secondary);
	}

	.ck-sx ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.ck-sx li {
		margin: 0;
	}

	/* Layout only; the surface and hover come from `.ck-card`. */
	.ck-sx-area a {
		padding: 0.95rem 1.2rem;
	}

	.ck-sx-title {
		display: block;
		font-size: 1.0625rem;
		font-weight: 650;
		letter-spacing: -0.015em;
		color: var(--color-text-primary);
	}

	/* The airframe (or "General") inside a subject area. Quieter than the area
	   heading above it and louder than an article title below, so the three
	   levels read as three levels. */
	.ck-sx-gh {
		margin: 1.1rem 0 0.4rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.ck-sx-group:first-of-type .ck-sx-gh {
		margin-top: 0;
	}

	.ck-sx-parts {
		margin-inline-start: 0.5rem;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--color-text-muted);
	}

	.ck-sx-area a[data-ck-done] .ck-sx-title::after {
		content: '✓';
		margin-inline-start: 0.45rem;
		font-size: 0.85rem;
		color: var(--color-ok);
	}

	.ck-sx-desc {
		display: block;
		margin-top: 0.3rem;
		font-size: 0.8125rem;
		line-height: 1.6;
		color: var(--color-text-secondary);
	}

	.ck-sx-planned {
		margin: 2rem 0 0;
		font-size: 0.8125rem;
		line-height: 1.6;
		color: var(--color-text-muted);
	}
</style>
