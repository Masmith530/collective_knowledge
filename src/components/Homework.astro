---
/**
 * Homework — what the student does before the next session.
 *
 * Separated from KeyNotes because the two serve different moments: key notes
 * are for review, homework is a to-do list the student works through.
 */
interface Props {
	title?: string;
	/** Shown beside the title, e.g. "Before L3". */
	due?: string;
}

const { title = 'Homework', due } = Astro.props;
---

<aside class="ck-homework" aria-label={title}>
	<p class="ck-homework-title">
		<span class="ck-homework-label">
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="15"
				height="15"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M9 11l3 3 8-8"></path>
				<path d="M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"></path>
			</svg>
			{title}
		</span>
		{due && <span class="ck-homework-due">{due}</span>}
	</p>
	<div class="ck-homework-body">
		<slot />
	</div>
</aside>

<style>
	.ck-homework {
		margin: 2rem 0;
		padding: 1.1rem 1.35rem;
		border: 1px solid var(--color-border);
		border-left: 3px solid var(--color-warn);
		border-radius: 8px;
		background: var(--color-canvas-subtle);
	}

	.ck-homework-title {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0 0 0.6rem;
	}

	.ck-homework-label {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-warn);
	}

	.ck-homework-due {
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--color-text-muted);
	}

	.ck-homework-body :global(> :first-child) {
		margin-top: 0;
	}

	.ck-homework-body :global(> :last-child) {
		margin-bottom: 0;
	}

	.ck-homework-body :global(ul),
	.ck-homework-body :global(ol) {
		padding-left: 1.2rem;
	}

	.ck-homework-body :global(li + li) {
		margin-top: 0.35rem;
	}
</style>
